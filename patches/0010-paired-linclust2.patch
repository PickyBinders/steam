diff --git a/src/alignment/PairedClusterAlignment.h b/src/alignment/PairedClusterAlignment.h
new file mode 100644
index 00000000..a58d1b9d
--- /dev/null
+++ b/src/alignment/PairedClusterAlignment.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <memory>
+#include "Matcher.h"
+
+class PairedClusterAlignment {
+public:
+    class Worker {
+    public:
+        virtual ~Worker() = default;
+        virtual void prepare(DBKeyType key, const char *tea, unsigned int length) = 0;
+        virtual bool align(DBKeyType key, const char *tea, unsigned int length,
+                           unsigned short diagonal, bool member, Matcher::result_t &result) = 0;
+    };
+
+    virtual ~PairedClusterAlignment() = default;
+    virtual std::unique_ptr<Worker> worker(unsigned int thread) = 0;
+};
