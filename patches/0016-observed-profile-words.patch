+#ifndef OBSERVED_PROFILE_WORDS_H
+#define OBSERVED_PROFILE_WORDS_H
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Companion query.words: numeric query key, zero-based start, seven TEA symbols.
+// A missing key denotes an empty vocabulary, never profile-word expansion.
+class ObservedProfileWords {
+public:
+    using Words = std::vector<std::pair<size_t, std::string>>;
+
+    void load(const std::string &path) {
+        std::ifstream input(path);
+        if (!input) fail("Cannot read observed profile words");
+        read(input);
+    }
+
+    void read(std::istream &input) {
+        unsigned int key;
+        size_t position;
+        std::string span;
+        words.clear();
+        while (input >> key) {
+            if (!(input >> position >> span) || span.size() != 7
+                    || span.find_first_not_of("ACDEFGHIKLMNPQRSTVWY") != std::string::npos)
+                fail("Invalid observed profile word");
+            words[key].emplace_back(position, span);
+        }
+        if (!input.eof()) fail("Invalid observed profile word key");
+    }
+
+    const Words &get(unsigned int key, size_t length) const {
+        static const Words empty;
+        const auto found = words.find(key);
+        if (found == words.end()) return empty;
+        for (const auto &word : found->second)
+            if (length < 7 || word.first > length - 7)
+                fail("Observed word outside query profile");
+        return found->second;
+    }
+
+private:
+    std::map<unsigned int, Words> words;
+    static void fail(const char *message) {
+        std::fprintf(stderr, "%s\n", message);
+        std::exit(EXIT_FAILURE);
+    }
+};
+#endif
