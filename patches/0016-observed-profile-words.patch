+static bool observedProfileWords(Sequence *query, BaseMatrix *matrix, Indexer &indexer,
+                                 int k, std::vector<std::vector<size_t>> &indices) {
+    const char *path = std::getenv("STEAM_OBSERVED_PROFILE_WORDS");
+    if (path == nullptr) return false;
+    const unsigned char positions[] = {0, 1, 2, 4, 5, 6};
+    if (query->profile_matrix == nullptr || k != 6
+            || std::memcmp(query->getAAPosInSpacedPattern(), positions, 6) != 0) {
+        Debug(Debug::ERROR) << "Observed profile words require k6/1110111\n";
+        EXIT(EXIT_FAILURE);
+    }
+    // One load per prefilter process; local-static initialization is synchronized.
+    static const ObservedProfileWords vocabulary = [&] {
+        ObservedProfileWords words;
+        words.load(path);
+        return words;
+    }();
+    for (const auto &word : vocabulary.get(query->getDbKey(), query->L)) {
+        unsigned char symbols[6];
+        for (size_t i = 0; i < 6; ++i)
+            symbols[i] = matrix->aa2num[static_cast<unsigned char>(word.second[positions[i]])];
+        if (indices.size() <= word.first) indices.resize(word.first + 1);
+        indices[word.first].push_back(indexer.int2index(symbols));
+    }
+    for (auto &row : indices) {
+        std::sort(row.begin(), row.end());
+        row.erase(std::unique(row.begin(), row.end()), row.end());
+    }
+    return true;
+}
