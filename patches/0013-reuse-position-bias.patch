+#[cfg(test)]
+mod pos_bias_tests {
+    use super::PosBias;
+
+    #[test]
+    fn reuse_preserves_values_and_zero_padding() {
+        let mut bias = PosBias::new(4096, 64);
+        for len in [4096, 13, 2053, 0, 4000, 11] {
+            let values: Vec<i16> = (0..len).map(|i| (i % 19) as i16 - 9).collect();
+            bias.set_biases(&values);
+            assert_eq!(bias.len(), len);
+            assert_eq!(&bias.bias[1..len + 1], values.as_slice());
+            assert_eq!(bias.bias[0], 0);
+            assert!(bias.bias[len + 1..].iter().all(|&value| value == 0));
+        }
+    }
+}
