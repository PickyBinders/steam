+
+void Prefiltering::setGlobalBucketThreshold(IndexTable *counts) {
+    bucketStatisticsReady = true;
+    globalBucketThreshold = 0;
+    if (steamBucketCoveragePct <= 0.0) {
+        return;
+    }
+
+    const auto started = std::chrono::steady_clock::now();
+    const size_t tableSize = counts->getTableSize();
+    std::vector<size_t> bucketSizes;
+    bucketSizes.reserve(tableSize);
+    size_t totalEntries = 0;
+    for (size_t kmer = 0; kmer < tableSize; kmer++) {
+        const size_t bucketSize = counts->getOffset(kmer + 1) - counts->getOffset(kmer);
+        if (bucketSize > 0) {
+            bucketSizes.push_back(bucketSize);
+            totalEntries += bucketSize;
+        }
+    }
+    const auto scanned = std::chrono::steady_clock::now();
+    Debug(Debug::INFO) << "[steam-bucket-filter] sorting "
+                       << bucketSizes.size() << " non-empty buckets...\n";
+    std::sort(bucketSizes.begin(), bucketSizes.end(), std::greater<size_t>());
+    const auto sorted = std::chrono::steady_clock::now();
+    const size_t target = static_cast<size_t>(
+        totalEntries * steamBucketCoveragePct / 100.0);
+    size_t cumulative = 0;
+    for (size_t bucketSize : bucketSizes) {
+        cumulative += bucketSize;
+        if (cumulative >= target) {
+            globalBucketThreshold = bucketSize;
+            break;
+        }
+    }
+    const auto completed = std::chrono::steady_clock::now();
+    const size_t bucketFloor = 10;
+    if (globalBucketThreshold > 0 && globalBucketThreshold < bucketFloor) {
+        Debug(Debug::INFO) << "[steam-bucket-filter] threshold "
+                           << globalBucketThreshold << " below floor "
+                           << bucketFloor
+                           << " (distribution too uniform); filter disabled\n";
+        globalBucketThreshold = 0;
+    }
+    auto milliseconds = [](auto begin, auto end) {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+            end - begin).count();
+    };
+    Debug(Debug::INFO) << "[steam-bucket-filter] global coverage="
+                       << steamBucketCoveragePct << "% -> bucket threshold "
+                       << globalBucketThreshold << " (entries=" << totalEntries
+                       << " non-empty-buckets=" << bucketSizes.size()
+                       << " scan=" << milliseconds(started, scanned) << "ms"
+                       << " sort=" << milliseconds(scanned, sorted) << "ms"
+                       << " cumsum=" << milliseconds(sorted, completed) << "ms)\n";
 }
 
