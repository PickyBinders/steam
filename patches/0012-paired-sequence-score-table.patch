+void QueryMatcher::preparePairedSequenceScores() {
+    const int teaSize = ungappedAlignmentSubMat->alphabetSize;
+    const int aaSize = externalAuxSubMat->alphabetSize;
+    const size_t states = teaSize * aaSize;
+    pairedScores.resize(states * states);
+    for (int qt = 0; qt < teaSize; ++qt) {
+        for (int qa = 0; qa < aaSize; ++qa) {
+            auto *row = pairedScores.data() + (qt * aaSize + qa) * states;
+            for (int tt = 0; tt < teaSize; ++tt) {
+                for (int ta = 0; ta < aaSize; ++ta) {
+                    const int score = ungappedAlignmentSubMat->subMatrix[qt][tt] + externalAuxSubMat->subMatrix[qa][ta];
+                    if (score < INT8_MIN || score > INT8_MAX) {
+                        pairedScores.clear();
+                        return;
+                    }
+                    row[tt * aaSize + ta] = static_cast<signed char>(score);
+                }
+            }
+        }
+    }
+}
