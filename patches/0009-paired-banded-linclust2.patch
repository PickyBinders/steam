+DistanceCalculator::LocalAlignment BlockAligner::pairedUngapped(const Sequence *target, unsigned short encodedDiagonal) const {
+        DistanceCalculator::LocalAlignment best;
+        const int qLen = queryLength, tLen = target->L;
+        for (int diag = static_cast<int>(encodedDiagonal) - 65536; diag < qLen; diag += 65536) {
+            if (diag <= -tLen) continue;
+            const int q = std::max(diag, 0), t = std::max(-diag, 0);
+            const int span = std::min(qLen - q, tLen - t);
+            auto alignment = DistanceCalculator::bestLocalDiagonal(span,
+                [&](unsigned int i) { return pairedScore(q + i, target, t + i); });
+            if (alignment.score > best.score) {
+                best = alignment;
+                best.diagonal = diag;
+                best.distToDiagonal = std::abs(diag);
+            }
+        }
+        return best;
+    }
