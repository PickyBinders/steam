+template<typename Entry>
+static size_t dropFrequentSteamBuckets(Entry *entries, size_t count) {
+    const char *configuredCoverage = getenv("STEAM_BUCKET_COVERAGE_PCT");
+    const double coverage = configuredCoverage ? atof(configuredCoverage) : 10.0;
+    if (!getenv("STEAM_CLUSTER_DEFAULTS") || coverage <= 0.0 || count == 0) {
+        return count;
+    }
+    auto endOfBucket = [&](size_t start) {
+        size_t end = start + 1;
+        while (end < count && entries[end].kmer == entries[start].kmer) ++end;
+        return end;
+    };
+    std::map<size_t, size_t, std::greater<size_t>> frequency;
+    for (size_t start = 0; start < count && entries[start].kmer != SIZE_T_MAX;) {
+        const size_t end = endOfBucket(start);
+        ++frequency[end - start];
+        start = end;
+    }
+    const double target = count * coverage / 100.0;
+    size_t covered = 0;
+    size_t threshold = 0;
+    for (const auto &bucket : frequency) {
+        covered += bucket.first * bucket.second;
+        threshold = bucket.first;
+        if (covered >= target) break;
+    }
+    if (threshold < 10) return count;
+    size_t kept = 0;
+    for (size_t start = 0; start < count;) {
+        const size_t end = endOfBucket(start);
+        if (end - start <= threshold && entries[start].kmer != SIZE_T_MAX) {
+            if (kept != start) std::copy(entries + start, entries + end, entries + kept);
+            kept += end - start;
+        }
+        start = end;
+    }
+    entries[kept].kmer = SIZE_T_MAX;
+    Debug(Debug::INFO) << "[steam-linclust-bucket-filter] kept " << kept << " of " << count
+                       << " k-mer entries, threshold " << threshold << "\n";
+    return kept;
+}
