+unsigned int QueryMatcher::scoreExternalCombined(const unsigned char *queryPrimary, unsigned int queryPrimaryLen,
+                                                  const unsigned char *queryAux, unsigned int queryAuxLen,
+                                                  const unsigned char *targetPrimary, unsigned int targetPrimaryLen,
+                                                  const unsigned char *targetAux, unsigned int targetAuxLen,
+                                                  short diagonal) const {
+    const unsigned int distance = static_cast<unsigned int>(std::abs(static_cast<int>(diagonal)));
+    const unsigned int queryOffset = (diagonal >= 0) ? distance : 0;
+    const unsigned int targetOffset = (diagonal >= 0) ? 0 : distance;
+    if (queryOffset >= queryPrimaryLen || queryOffset >= queryAuxLen ||
+        targetOffset >= targetPrimaryLen || targetOffset >= targetAuxLen) {
+        return 0;
+    }
+
+    const unsigned int length = std::min(
+        std::min(queryPrimaryLen - queryOffset, queryAuxLen - queryOffset),
+        std::min(targetPrimaryLen - targetOffset, targetAuxLen - targetOffset));
+    int score = 0;
+    int maxScore = 0;
+    for (unsigned int pos = 0; pos < length; pos++) {
+        score += ungappedAlignmentSubMat->subMatrix[queryPrimary[queryOffset + pos]][targetPrimary[targetOffset + pos]];
+        score += externalAuxSubMat->subMatrix[queryAux[queryOffset + pos]][targetAux[targetOffset + pos]];
+        score = std::max(score, 0);
+        maxScore = std::max(maxScore, score);
+    }
+    return static_cast<unsigned int>(maxScore);
+}
+
+unsigned int QueryMatcher::scoreExternalCombined(CounterResult &result) const {
+    std::pair<const unsigned char *, const unsigned int> targetPrimary = primarySequenceLookup->getSequence(result.id);
+    std::pair<const unsigned char *, const unsigned int> targetAux = externalAuxSequenceLookup->getSequence(result.id);
+    return scoreExternalCombined(currentQuerySeq->numSequence, currentQuerySeq->L,
+                                 externalAuxQuerySeq->numSequence, externalAuxQuerySeq->L,
+                                 targetPrimary.first, targetPrimary.second,
+                                 targetAux.first, targetAux.second,
+                                 static_cast<short>(result.diagonal));
+}
