+    for (size_t id = dbFrom; id < dbTo; id++) {
+        totalLength += tdbrExternalAux->getSeqLen(id);
+    }
+    sequenceLookupExternalAux = new SequenceLookup(dbTo - dbFrom, totalLength);
+    Sequence auxSeq(maxSeqLen, Parameters::DBTYPE_AMINO_ACIDS, externalAuxSubMat, 0, false, false);
