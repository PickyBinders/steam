+        if (tdbrExternalAux->getDbKey(id) != tdbr->getDbKey(id) ||
+            tdbrExternalAux->getSeqLen(id) != tdbr->getSeqLen(id)) {
+            Debug(Debug::ERROR) << "TEA/AA target database key or length mismatch at sequence "
+                                << tdbr->getDbKey(id) << "\n";
+            EXIT(EXIT_FAILURE);
+        }
+        auxSeq.mapSequence(id - dbFrom, tdbrExternalAux->getDbKey(id),
+                           tdbrExternalAux->getData(id, 0), tdbrExternalAux->getSeqLen(id));
+        sequenceLookupExternalAux->addSequence(&auxSeq);
+    }
